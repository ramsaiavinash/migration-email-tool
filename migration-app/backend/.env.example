# Power Automate HTTP Trigger URL
# Get this from Power Automate → When an HTTP request is received → copy the HTTP POST URL
POWER_AUTOMATE_URL=https://prod-xx.westus.logic.azure.com/workflows/YOUR_FLOW_URL_HERE

# SharePoint configuration (for uploading processed reports)
SHAREPOINT_SITE_URL=https://chspsc.sharepoint.com/sites/ITMigration
SHAREPOINT_LIBRARY=Migration Reports

# Optional: Microsoft Graph API (for SharePoint upload from backend)
AZURE_TENANT_ID=your-tenant-id
AZURE_CLIENT_ID=your-client-id
AZURE_CLIENT_SECRET=your-client-secret

# Frontend URL (for CORS)
FRONTEND_URL=https://your-org.github.io

# Port
PORT=3001
